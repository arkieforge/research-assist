# Local overrides for `vp run dev`. Team members get everything from Doppler (arkie/dev) instead and
# need no .env at all: `doppler login && doppler setup` (docs/operations/secrets.md).
# Everyone else: copy to .env and fill the two Clerk keys. That is the whole list for a working app.
# Ports and URLs between the apps are set by scripts/dev.ts; don't put them here.

# Required. Clerk dashboard > API keys (a free dev instance is fine).
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Optional. Without it the chat uses the free Replay (dev) model (docs/operations/development.md).
ARKIE_ANTHROPIC_API_KEY=

# Optional. Browser analytics; off when empty.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional pair. The chat agent connects to this T3 Code MCP server as a client.
T3_MCP_URL=
T3_MCP_TOKEN=
# Comma-separated Clerk user ids allowed to use T3 tools (that token drives your T3 machine). Empty = nobody.
T3_ALLOWED_USER_IDS=
